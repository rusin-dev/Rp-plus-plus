# ===== 供应商配置（多 provider） =====
# 当前选择的供应商与模型
PROVIDER=deepseek
MODEL=deepseek-v4-flash

# 每个供应商用 PROVIDER_<名称>_ 前缀配置：
#   API_KEY 必填；API_URL / MODELS(逗号分隔) / DEFAULT_MODEL 可选
PROVIDER_DEEPSEEK_API_KEY=your_api_key_here
PROVIDER_DEEPSEEK_API_URL=https://api.deepseek.com/v1
PROVIDER_DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
PROVIDER_DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# 复制下面块可添加更多供应商
# PROVIDER_OPENAI_API_KEY=sk-xxx
# PROVIDER_OPENAI_API_URL=https://api.openai.com/v1
# PROVIDER_OPENAI_MODELS=gpt-4o,gpt-4o-mini
# PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o

# 兼容旧版单供应商配置（未配置 PROVIDER_* 时生效）
# CUSTOM_API_KEY=your_api_key_here
# CUSTOM_API_URL=https://api.deepseek.com/v1
# RP_MODEL=deepseek-v4-flash

# 思考强度（fast / default / deep），也可用 /variants 切换
# RP_VARIANT=default

# 网页搜索后端（bing / ddg / auto，auto 表示 ddg 失败时回退 bing）
# SEARCH_BACKEND=bing

# 日志
LOG_LEVEL=INFO
LOG_DIR=log

# 终端输出
# RICH_COLOR_SYSTEM=auto
# TAB_SIZE=8
