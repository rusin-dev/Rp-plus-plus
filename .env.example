# ===== 供应商配置 =====
# 供应商配置现在使用 JSON 文件存储，无需在本文件配置 API Key。
#
# 预设模板位于 src/data/providers/preset/<名称>.json（不含 API Key）：
#   运行 rp 后输入 /connect，用 ↑↓ 选择预设、Enter 确认，输入 API Key，
#   程序会在 src/data/providers/<名称>.json 生成完整配置并自动切换。
#   当前选中的 provider/model 会持久化到 .rp/config.json。
#
# 也可以手动创建 src/data/providers/<名称>.json：
#   {
#       "name": "deepseek",
#       "api_url": "https://api.deepseek.com/v1",
#       "models": ["deepseek-chat", "deepseek-reasoner"],
#       "default_model": "deepseek-chat",
#       "api_key": "sk-xxx"
#   }

# 思考强度（fast / default / deep），也可用 /variants 切换
# RP_VARIANT=default

# 网页搜索后端（bing / ddg / auto，auto 表示 ddg 失败时回退 bing）
# SEARCH_BACKEND=bing

# 日志
LOG_LEVEL=INFO
LOG_DIR=log

# 会话自动 git：启动时在 ROOT_DIR 自动初始化 git 仓库，
# 并在每轮对话结束后自动提交工作区改动（设为 0 关闭）
# RP_AUTO_GIT=1

# 终端输出
# RICH_COLOR_SYSTEM=auto
# TAB_SIZE=8
